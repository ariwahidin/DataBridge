@model List<DataBridge.Models.ViewModels.MirrorTableBuilder.TableInfoViewModel>
@{
    ViewData["Title"] = "Data Explorer";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Data Explorer</h1>
        <p class="page-subtitle">Browse and search data in Mirror database tables</p>
    </div>
    <a href="/MirrorTableBuilder/Create" class="btn btn-ghost">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
        New Table
    </a>
</div>

<!-- Search tables -->
<div class="mb-3">
    <input type="text" id="tableSearch" class="form-control" placeholder="🔍  Filter tables..." style="max-width:320px" />
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center p-5">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" class="mb-3"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            <p class="text-muted">No tables found in the Mirror database.</p>
            <a href="/MirrorTableBuilder/Create" class="btn btn-primary mt-2">Create your first table</a>
        </div>
    </div>
}
else
{
    <div class="row g-3" id="tableGrid">
        @foreach (var t in Model)
        {
            var tableParts = t.TableName.Split('.');
            var displayName = tableParts.Length > 1 ? tableParts[1] : t.TableName;
            var schema = tableParts.Length > 1 ? tableParts[0] : "dbo";

            <div class="col-sm-6 col-lg-4 col-xl-3 table-card-wrapper" data-name="@t.TableName.ToLower()">
                <a href="/MirrorDataExplorer/Browse?tableName=@Uri.EscapeDataString(t.TableName)"
                   class="card table-card text-decoration-none h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between mb-2">
                            <div class="table-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8">
                                    <rect x="3" y="3" width="18" height="18" rx="2" />
                                    <line x1="3" y1="9" x2="21" y2="9" />
                                    <line x1="9" y1="21" x2="9" y2="9" />
                                </svg>
                            </div>
                            <span class="badge badge-secondary text-xs">@schema</span>
                        </div>
                        <div class="table-name fw-semibold text-sm mb-1">@displayName</div>
                        <div class="d-flex gap-3 mt-2">
                            <span class="text-muted text-xs">@t.ColumnCount cols</span>
                            <span class="text-muted text-xs">@(t.RowCount >= 0 ? t.RowCount.ToString("N0") + " rows" : "—")</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

@section Styles {
    <style>
        .table-card {
            border: 1px solid var(--border);
            border-radius: 10px;
            transition: box-shadow 0.15s, border-color 0.15s;
            color: var(--text);
        }

            .table-card:hover {
                border-color: var(--accent);
                box-shadow: 0 2px 12px rgba(0,0,0,0.08);
                color: var(--text);
            }

        .table-icon {
            width: 36px;
            height: 36px;
            background: rgba(var(--accent-rgb, 79,70,229), 0.08);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .table-name {
            font-size: 14px;
        }
    </style>
}

@section Scripts {
    <script>
        document.getElementById('tableSearch').addEventListener('input', function() {
            const q = this.value.toLowerCase();
            document.querySelectorAll('.table-card-wrapper').forEach(el => {
                el.style.display = el.dataset.name.includes(q) ? '' : 'none';
            });
        });
    </script>
}
