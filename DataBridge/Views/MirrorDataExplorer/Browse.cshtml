@{
    ViewData["Title"] = $"Browse — {ViewBag.TableName}";
    string tableName = ViewBag.TableName;
    var columns = ViewBag.Columns as List<DataBridge.Models.ViewModels.MirrorTableBuilder.ColumnInfoViewModel>
                  ?? new();
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" class="me-2" style="vertical-align:-3px"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>
            @tableName
        </h1>
        <p class="page-subtitle">@columns.Count column(s) &nbsp;·&nbsp; <span id="totalCount">Loading...</span> rows</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/MirrorDataExplorer" class="btn btn-ghost">← All Tables</a>
        <a href="/MirrorTableBuilder" class="btn btn-ghost">Table Builder</a>
    </div>
</div>

<!-- Toolbar -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <!-- Global search -->
            <div class="input-group" style="width:260px">
                <span class="input-group-text">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                </span>
                <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Search all text columns..." />
            </div>

            <!-- Column filter -->
            <select id="filterColumn" class="form-select form-select-sm" style="width:160px">
                <option value="">— Filter by column —</option>
                @foreach (var col in columns)
                {
                    <option value="@col.ColumnName">@col.ColumnName</option>
                }
            </select>
            <input type="text" id="filterValue" class="form-control form-control-sm"
                   placeholder="Filter value..." style="width:160px" />

            <!-- Page size -->
            <select id="pageSizeSelect" class="form-select form-select-sm" style="width:100px">
                <option value="20">20 / page</option>
                <option value="50">50 / page</option>
                <option value="100">100 / page</option>
            </select>

            <button class="btn btn-sm btn-ghost ms-auto" id="clearFiltersBtn">Clear Filters</button>
        </div>
    </div>
</div>

<!-- Data table -->
<div class="card">
    <div class="card-body p-0" style="overflow-x:auto">
        <div id="loadingIndicator" class="text-center p-4">
            <div class="spinner-border spinner-border-sm text-muted" role="status"></div>
            <span class="text-muted ms-2">Loading data...</span>
        </div>
        <table class="table table-hover table-sm mb-0 data-table" id="dataTable" style="display:none; min-width:600px">
            <thead id="tableHead"></thead>
            <tbody id="tableBody"></tbody>
        </table>
        <div id="emptyState" class="text-center p-5" style="display:none">
            <p class="text-muted">No data found matching your filters.</p>
        </div>
    </div>
    <!-- Pagination -->
    <div class="card-footer d-flex align-items-center justify-content-between">
        <span class="text-muted text-sm" id="paginationInfo">—</span>
        <div class="d-flex gap-1" id="paginationBtns"></div>
    </div>
</div>

@section Scripts {
    <script>
        const TABLE_NAME = '@Html.Raw(tableName)';
        const COLUMNS    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(columns.Select(c => new { c.ColumnName, c.DataType })));

        let state = {
            search: '',
            filterColumn: '',
            filterValue: '',
            sortColumn: null,
            sortDir: 'asc',
            page: 1,
            pageSize: 20,
        };

        let debounceTimer = null;

        // ── Fetch data ────────────────────────────────────────────────────────────────
        async function loadData() {
            document.getElementById('loadingIndicator').style.display = '';
            document.getElementById('dataTable').style.display = 'none';
            document.getElementById('emptyState').style.display = 'none';

            const params = new URLSearchParams({
                tableName:    TABLE_NAME,
                search:       state.search,
                filterColumn: state.filterColumn,
                filterValue:  state.filterValue,
                sortColumn:   state.sortColumn ?? '',
                sortDir:      state.sortDir,
                page:         state.page,
                pageSize:     state.pageSize,
            });

            try {
                const resp = await fetch(`/MirrorDataExplorer/GetData?${params}`);
                const text = await resp.text();
                let data;
                try {
                    data = JSON.parse(text);
                } catch(parseErr) {
                    document.getElementById('loadingIndicator').innerHTML =
                        `<span class="text-danger">JSON parse error: ${parseErr.message}<br><pre style="font-size:10px;text-align:left">${text.substring(0,500)}</pre></span>`;
                    return;
                }
                // Debug: tampilkan di console
                console.log('GetData response:', data);
                console.log('Rows count:', (data.Rows ?? data.rows ?? []).length, '| TotalCount:', data.TotalCount ?? data.totalCount);
                renderTable(data);
            } catch (err) {
                console.error(err);
                document.getElementById('loadingIndicator').innerHTML = '<span class="text-danger">Fetch error: ' + err.message + '</span>';
            }
        }

        // ── Render table ──────────────────────────────────────────────────────────────
        function renderTable(data) {
            document.getElementById('loadingIndicator').style.display = 'none';
            document.getElementById('totalCount').textContent = (data.TotalCount ?? data.totalCount ?? 0).toLocaleString();

            const rows = data.Rows ?? data.rows ?? [];
            const columns = data.Columns ?? data.columns ?? [];
            const totalCount = data.TotalCount ?? data.totalCount ?? 0;
            const totalPages = data.TotalPages ?? data.totalPages ?? 1;
            const currentPage = data.Page ?? data.page ?? 1;

            if (!rows || rows.length === 0) {
                document.getElementById('emptyState').style.display = '';
                document.getElementById('paginationInfo').textContent = 'No results';
                document.getElementById('paginationBtns').innerHTML = '';
                return;
            }

            // Build header
            const thead = document.getElementById('tableHead');
            thead.innerHTML = '<tr>' + columns.map(col => {
                const isSorted = state.sortColumn === col;
                const icon = isSorted ? (state.sortDir === 'asc' ? ' ↑' : ' ↓') : '';
                return `<th class="sortable-col" data-col="${col}" style="cursor:pointer;white-space:nowrap;font-size:12px">
                    ${col}${icon}
                </th>`;
            }).join('') + '</tr>';

            // Sort click
            thead.querySelectorAll('.sortable-col').forEach(th => {
                th.addEventListener('click', () => {
                    const col = th.dataset.col;
                    if (state.sortColumn === col) {
                        state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
                    } else {
                        state.sortColumn = col;
                        state.sortDir = 'asc';
                    }
                    state.page = 1;
                    loadData();
                });
            });

            // Build body
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = rows.map(row =>
                '<tr>' + columns.map(col => {
                    const val = row[col];
                    if (val === null || val === undefined) return '<td><span class="text-muted text-xs fst-italic">NULL</span></td>';
                    const str = String(val);
                    const display = str.length > 120 ? str.substring(0, 120) + '…' : str;
                    return `<td style="font-size:12px;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escHtml(str)}">${escHtml(display)}</td>`;
                }).join('') + '</tr>'
            ).join('');

            document.getElementById('dataTable').style.display = '';

            // Pagination info
            const pageSize2 = data.PageSize ?? data.pageSize ?? 20;
            const start = (currentPage - 1) * pageSize2 + 1;
            const end   = Math.min(currentPage * pageSize2, totalCount);
            document.getElementById('paginationInfo').textContent =
                `Showing ${start.toLocaleString()}–${end.toLocaleString()} of ${totalCount.toLocaleString()} rows`;

            // Pagination buttons
            renderPagination(currentPage, totalPages);
        }

        function renderPagination(current, total) {
            const container = document.getElementById('paginationBtns');
            const pages = [];

            // Always show first, last, current ± 2
            const show = new Set();
            show.add(1); show.add(total);
            for (let i = Math.max(1, current - 2); i <= Math.min(total, current + 2); i++) show.add(i);

            const sorted = [...show].sort((a, b) => a - b);

            let html = '';
            let prev = 0;
            for (const p of sorted) {
                if (p - prev > 1) html += `<span class="btn btn-xs btn-ghost disabled">…</span>`;
                const active = p === current ? 'btn-primary' : 'btn-ghost';
                html += `<button class="btn btn-xs ${active} page-btn" data-page="${p}">${p}</button>`;
                prev = p;
            }

            // Prev / Next
            html = `<button class="btn btn-xs btn-ghost page-btn" data-page="${current - 1}" ${current === 1 ? 'disabled' : ''}>‹</button>`
                 + html
                 + `<button class="btn btn-xs btn-ghost page-btn" data-page="${current + 1}" ${current === total ? 'disabled' : ''}>›</button>`;

            container.innerHTML = html;
            container.querySelectorAll('.page-btn:not([disabled])').forEach(btn => {
                btn.addEventListener('click', () => {
                    state.page = parseInt(btn.dataset.page);
                    loadData();
                });
            });
        }

        function escHtml(str) {
            return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // ── Toolbar events ────────────────────────────────────────────────────────────
        function debounce(fn, ms = 400) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(fn, ms);
        }

        document.getElementById('searchInput').addEventListener('input', e => {
            state.search = e.target.value;
            state.page = 1;
            debounce(loadData);
        });

        document.getElementById('filterColumn').addEventListener('change', e => {
            state.filterColumn = e.target.value;
            state.page = 1;
            loadData();
        });

        document.getElementById('filterValue').addEventListener('input', e => {
            state.filterValue = e.target.value;
            state.page = 1;
            debounce(loadData);
        });

        document.getElementById('pageSizeSelect').addEventListener('change', e => {
            state.pageSize = parseInt(e.target.value);
            state.page = 1;
            loadData();
        });

        document.getElementById('clearFiltersBtn').addEventListener('click', () => {
            state.search = ''; state.filterColumn = ''; state.filterValue = '';
            state.sortColumn = null; state.sortDir = 'asc'; state.page = 1;
            document.getElementById('searchInput').value = '';
            document.getElementById('filterColumn').value = '';
            document.getElementById('filterValue').value = '';
            loadData();
        });

        // ── Init ──────────────────────────────────────────────────────────────────────
        loadData();
    </script>
}
