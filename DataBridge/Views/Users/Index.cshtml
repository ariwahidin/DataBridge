@* FILE: Views/Users/Index.cshtml *@
@model DataBridge.Models.ViewModels.Users.UserListViewModel
@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <div>
        <div class="page-title">Users</div>
        <div class="page-subtitle">Manage system accounts and permissions</div>
    </div>
    <div class="page-actions">
        <a href="/Users/Create" class="btn btn-primary">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New User
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        @TempData["Error"]
    </div>
}

<!-- Filters -->
<div class="card" style="margin-bottom:16px;">
    <div class="card-body" style="padding:12px 16px;">
        <form method="get" action="/Users" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
            <div style="flex:1;min-width:200px;">
                <label class="form-label">Search</label>
                <input name="search" class="form-control" placeholder="Username, full name, or email…"
                       value="@Model.SearchQuery" />
            </div>
            <div style="min-width:140px;">
                <label class="form-label">Role</label>
                <select name="role" class="form-control">
                    <option value="">All Roles</option>
                    <option value="Admin"  selected = "@(Model.RoleFilter == "Admin"  ? "selected" : "")">Admin</option>
                    <option value="Viewer" selected=" @(Model.RoleFilter == "Viewer" ? "selected" : "")">Viewer</option>
                </select>
            </div>
            <div style="display:flex;gap:8px;">
                <button type="submit" class="btn btn-primary">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    Search
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.RoleFilter))
                {
                    <a href="/Users" class="btn btn-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>User</th>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Created</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Users.Any())
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <p>No users found.</p>
                        </div>
                    </td>
                </tr>
            }
            @foreach (var u in Model.Users)
            {
                var initials = string.Join("", u.FullName.Split(' ').Take(2).Select(w => w.Length > 0 ? w[0].ToString().ToUpper() : ""));
                <tr>
                    <td>
                        <div style="display:flex;align-items:center;gap:10px;">
                            <div class="user-avatar" style="width:32px;height:32px;font-size:11px;">@initials</div>
                            <span style="font-weight:500;color:var(--text-primary);">@u.FullName</span>
                        </div>
                    </td>
                    <td style="font-family:var(--mono);font-size:12px;">@u.Username</td>
                    <td>@u.Email</td>
                    <td>
                        @if (u.Role == DataBridge.Models.Enums.UserRole.Admin)
                        {
                            <span class="badge badge-info">Admin</span>
                        }
                        else
                        {
                            <span class="badge badge-muted">Viewer</span>
                        }
                    </td>
                    <td>
                        <button class="badge @(u.IsActive ? "badge-success" : "badge-danger")"
                                style="border:none;cursor:pointer;font-family:var(--mono);"
                                onclick="toggleActive(@u.Id, this)"
                                title="Click to toggle">
                            @(u.IsActive ? "Active" : "Inactive")
                        </button>
                    </td>
                    <td style="font-family:var(--mono);font-size:11.5px;color:var(--text-muted);">
                        @u.CreatedAt.ToString("dd MMM yyyy")
                    </td>
                    <td style="text-align:right;">
                        <div style="display:flex;gap:6px;justify-content:flex-end;">
                            <a href="/Users/Edit/@u.Id" class="btn btn-secondary btn-sm">Edit</a>
                            <a href="/Users/ResetPassword/@u.Id" class="btn btn-secondary btn-sm">
                                <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                Reset PW
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div style="margin-top:12px;font-size:12px;color:var(--text-muted);font-family:var(--mono);">
    @Model.Users.Count user(s) found
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
async function toggleActive(id, btn) {
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    btn.disabled = true;

    const res  = await fetch('/Users/ToggleActive', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `id=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
    });
    const data = await res.json();

    if (data.success) {
        const isNowActive = btn.classList.contains('badge-danger');
        btn.classList.toggle('badge-success', isNowActive);
        btn.classList.toggle('badge-danger',  !isNowActive);
        btn.textContent = isNowActive ? 'Active' : 'Inactive';
    } else {
        alert(data.error ?? 'Failed to update status.');
    }
    btn.disabled = false;
}
</script>
}
