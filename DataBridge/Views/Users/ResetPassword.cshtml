@* FILE: Views/Users/ResetPassword.cshtml *@
@model DataBridge.Models.ViewModels.Users.ResetPasswordViewModel
@{
    ViewData["Title"] = $"Reset Password — {Model.Username}";
}

<div class="page-header">
    <div>
        <div class="page-title">Reset Password</div>
        <div class="page-subtitle">Set a new password for <strong>@Model.FullName</strong> (@Model.Username)</div>
    </div>
    <div class="page-actions">
        <a href="/Users/Edit/@Model.Id" class="btn btn-secondary">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            Back to Edit
        </a>
    </div>
</div>

<div style="max-width:480px;">
    <div class="card">
        <div class="card-header">
            <span class="card-title">New Password</span>
        </div>
        <div class="card-body">

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <div class="alert alert-danger">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <div>
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <div class="alert alert-warning" style="margin-bottom:18px;">
                <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                The user will need to use this new password on their next login. Make sure to share it securely.
            </div>

            <form method="post" action="/Users/ResetPassword">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Username" />
                <input type="hidden" asp-for="FullName" />

                <div class="form-group">
                    <label class="form-label">New Password <span style="color:var(--danger)">*</span></label>
                    <div style="position:relative;">
                        <input asp-for="NewPassword" type="password" id="pw1"
                               class="form-control @(ViewData.ModelState["NewPassword"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               placeholder="Min. 6 characters" style="padding-right:36px;" autocomplete="new-password" />
                        <button type="button" class="toggle-pw-btn" onclick="togglePw('pw1','eye1')">
                            <svg id="eye1" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Confirm Password <span style="color:var(--danger)">*</span></label>
                    <div style="position:relative;">
                        <input asp-for="ConfirmPassword" type="password" id="pw2"
                               class="form-control @(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               placeholder="Re-enter password" style="padding-right:36px;" autocomplete="new-password" />
                        <button type="button" class="toggle-pw-btn" onclick="togglePw('pw2','eye2')">
                            <svg id="eye2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                </div>

                <div style="display:flex;gap:8px;margin-top:20px;">
                    <button type="submit" class="btn btn-primary">
                        <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        Reset Password
                    </button>
                    <a href="/Users" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
<style>
.toggle-pw-btn {
    position: absolute;
    right: 9px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 4px;
    display: flex;
    border-radius: 4px;
    transition: color 0.18s, background 0.18s;
}
.toggle-pw-btn:hover { color: var(--text-secondary); background: var(--bg-hover); }
.toggle-pw-btn svg { width: 13px; height: 13px; stroke: currentColor; fill: none; stroke-width: 1.7; }
</style>
}

@section Scripts {
<script>
function togglePw(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon  = document.getElementById(iconId);
    const show  = input.type === 'password';
    input.type  = show ? 'text' : 'password';
    icon.innerHTML = show
        ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>'
        : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
}
</script>
}
