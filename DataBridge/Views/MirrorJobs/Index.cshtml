@model DataBridge.Models.ViewModels.MirrorJobs.MirrorJobListViewModel
@{
    ViewData["Title"] = "Mirror Jobs";
}

<div class="page-header">
    <div><div class="page-title">Mirror Jobs</div><div class="page-subtitle">Define and manage data synchronization jobs</div></div>
    <div class="page-actions">
        <a href="/MirrorJobs/Create" class="btn btn-primary">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            New Job
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>@TempData["Error"]</div>
}

<!-- Toast notification for trigger feedback -->
<div id="triggerToast" style="display:none;position:fixed;bottom:24px;right:24px;z-index:9999;
     padding:12px 20px;border-radius:8px;font-size:13px;font-weight:500;
     box-shadow:0 4px 16px rgba(0,0,0,.25);transition:opacity .3s;"></div>

<div class="card" style="margin-bottom:16px;">
    <div class="card-body" style="padding:12px 16px;">
        <form method="get" style="display:flex;gap:10px;align-items:flex-end;">
            <div style="flex:1;">
                <label class="form-label">Search</label>
                <input name="search" class="form-control" placeholder="Job name, source, or destination table…" value="@Model.Search" />
            </div>
            <button type="submit" class="btn btn-primary"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>Search</button>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a href="/MirrorJobs" class="btn btn-secondary">Clear</a>
            }
        </form>
    </div>
</div>

<div class="table-wrap">
    <table class="data-table">
        <thead><tr><th>Job Name</th><th>Source</th><th>Destination Table</th><th>Mode</th><th>Schedule</th><th>Status</th><th style="text-align:right;">Actions</th></tr></thead>
        <tbody>
            @if (!Model.Jobs.Any())
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            <svg viewBox="0 0 24 24"><polyline points="16 3 21 3 21 8" /><line x1="4" y1="20" x2="21" y2="3" /><polyline points="21 16 21 21 16 21" /></svg>
                            <p>No mirror jobs yet. Create one to start syncing data.</p>
                        </div>
                    </td>
                </tr>
            }
            @foreach (var j in Model.Jobs)
            {
                <tr>
                    <td style="font-weight:500;color:var(--text-primary);">@j.Name</td>
                    <td>@j.SourceName</td>
                    <td style="font-family:var(--mono);font-size:12px;">@j.DestinationTable</td>
                    <td>
                        <span class="badge @(j.SyncMode == DataBridge.Models.Enums.SyncMode.Incremental ? "badge-info" : "badge-muted")">
                            @(j.SyncMode == DataBridge.Models.Enums.SyncMode.Incremental ? "Incremental" : "Full Replace")
                        </span>
                    </td>
                    <td>
                        @if (j.HasSchedule)
                        {
                            <div style="display:flex;align-items:center;gap:6px;">
                                <span class="badge @(j.ScheduleEnabled ? "badge-success" : "badge-muted")" style="font-size:10px;">
                                    @(j.ScheduleEnabled ? "On" : "Off")
                                </span>
                                <span style="font-family:var(--mono);font-size:11px;color:var(--text-muted);">@j.CronExpression</span>
                            </div>
                        }
                        else
                        {
                            <span style="color:var(--text-muted);font-size:12px;">Not set</span>
                        }
                    </td>
                    <td>
                        <button class="badge @(j.IsActive ? "badge-success" : "badge-danger")" style="border:none;cursor:pointer;" onclick="toggleJob(@j.Id, this)">
                            @(j.IsActive ? "Active" : "Inactive")
                        </button>
                    </td>
                    <td style="text-align:right;">
                        <div style="display:flex;gap:5px;justify-content:flex-end;">
                            <!-- NEW: Manual Run button -->
                            <button class="btn btn-secondary btn-sm" title="Run Now"
                                    onclick="triggerRun(@j.Id, '@j.Name', this)">
                                <svg viewBox="0 0 24 24" style="width:14px;height:14px;">
                                    <polygon points="5 3 19 12 5 21 5 3" />
                                </svg>
                            </button>
                            <a href="/MirrorJobs/Edit/@j.Id" class="btn btn-secondary btn-sm">Edit</a>
                            <a href="/Schedules/Configure?jobId=@j.Id" class="btn btn-secondary btn-sm">
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                            </a>
                            <form method="post" action="/MirrorJobs/Delete/@j.Id" style="display:inline"
                                  onsubmit="return confirm('Delete job \'@j.Name\'?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div style="margin-top:10px;font-size:12px;color:var(--text-muted);font-family:var(--mono);">@Model.Jobs.Count job(s)</div>

@Html.AntiForgeryToken()
@section Scripts {
    <script>
        const _token = () => document.querySelector('input[name="__RequestVerificationToken"]').value;

        // ── Toggle active ──────────────────────────────────────────────────────
        async function toggleJob(id, btn) {
            btn.disabled = true;
            const res = await fetch('/MirrorJobs/ToggleActive', {
                method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'},
                body: `id=${id}&__RequestVerificationToken=${encodeURIComponent(_token())}`
            });
            const d = await res.json();
            if (d.success) {
                const on = btn.classList.contains('badge-danger');
                btn.classList.toggle('badge-success', on); btn.classList.toggle('badge-danger', !on);
                btn.textContent = on ? 'Active' : 'Inactive';
            } else alert(d.error ?? 'Failed');
            btn.disabled = false;
        }

        // ── Manual trigger ─────────────────────────────────────────────────────
        async function triggerRun(id, name, btn) {
            if (!confirm(`Run job "${name}" now?`)) return;
            btn.disabled = true;
            btn.innerHTML = '<svg viewBox="0 0 24 24" style="width:14px;height:14px;animation:spin 1s linear infinite"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>';

            try {
                const res = await fetch('/MirrorJobs/TriggerRun', {
                    method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'},
                    body: `id=${id}&__RequestVerificationToken=${encodeURIComponent(_token())}`
                });
                const d = await res.json();
                showToast(d.success ? `✓ Job "${name}" triggered.` : `✗ ${d.error ?? 'Failed'}`, d.success);
            } catch(e) {
                showToast('✗ Request failed.', false);
            }

            btn.disabled = false;
            btn.innerHTML = '<svg viewBox="0 0 24 24" style="width:14px;height:14px;"><polygon points="5 3 19 12 5 21 5 3"/></svg>';
        }

        // ── Toast helper ───────────────────────────────────────────────────────
        function showToast(msg, success) {
            const t = document.getElementById('triggerToast');
            t.textContent = msg;
            t.style.background = success ? 'var(--success, #16a34a)' : 'var(--danger, #dc2626)';
            t.style.color = '#fff';
            t.style.display = 'block';
            t.style.opacity = '1';
            clearTimeout(t._timer);
            t._timer = setTimeout(() => {
                t.style.opacity = '0';
                setTimeout(() => t.style.display = 'none', 300);
            }, 3500);
        }
    </script>
    <style>
        @@keyframes spin {
            to

        {
            transform: rotate(360deg);
        }

        }
    </style>
}
