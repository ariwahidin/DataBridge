@model DataBridge.Models.ViewModels.MirrorJobs.MirrorJobFormViewModel
@{
    ViewData["Title"] = "Edit Mirror Job";
}

<div class="page-header">
    <div><div class="page-title">Edit Mirror Job</div><div class="page-subtitle">@Model.Name</div></div>
    <div class="page-actions"><a href="/MirrorJobs" class="btn btn-secondary"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>Back</a></div>
</div>

<div style="max-width:680px;">
    <div class="card">
        <div class="card-header"><span class="card-title">Job Configuration</span></div>
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <div class="alert alert-danger">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                    <div>
                        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@e.ErrorMessage</div>
                        }
                    </div>
                </div>
            }
            <form method="post" action="/MirrorJobs/Edit">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />

                <div class="form-group">
                    <label class="form-label">Job Name <span style="color:var(--danger)">*</span></label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="form-group">
                        <label class="form-label">Source <span style="color:var(--danger)">*</span></label>
                        <select asp-for="SourceId" class="form-control" id="sourceId">
                            @foreach (var s in Model.AvailableSources)
                            {
                                <option value="@s.Id" selected="@(s.Id == Model.SourceId ? "selected" : null)">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Destination Table <span style="color:var(--danger)">*</span></label>
                        <input asp-for="DestinationTable" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;">
                        <label class="form-label" style="margin-bottom:0;">Source Query <span style="color:var(--danger)">*</span></label>
                        <!-- NEW: Test Query button -->
                        <button type="button" class="btn btn-secondary btn-sm" onclick="testQuery()" id="btnTestQuery">
                            <svg viewBox="0 0 24 24" style="width:13px;height:13px;"><polyline points="22 11.08 22 12 12 22 2 12 2 2 12 2 2 12 12 22 2" /></svg>
                            Test Query
                        </button>
                    </div>
                    <textarea asp-for="SourceQuery" class="form-control" rows="5" id="sourceQuery"></textarea>
                    <div class="form-hint">SELECT / CTE only. UPDATE, DELETE, DROP etc. are blocked.</div>
                    <!-- Result banner for test query -->
                    <div id="queryTestResult" style="display:none;margin-top:8px;padding:8px 12px;border-radius:6px;font-size:12px;"></div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="form-group">
                        <label class="form-label">Sync Mode</label>
                        <select asp-for="SyncMode" class="form-control" id="syncMode" onchange="toggleWatermark()">
                            <option value="2">Full Replace</option>
                            <option value="1">Incremental</option>
                        </select>
                    </div>
                    <div class="form-group" id="watermarkGroup">
                        <label class="form-label">Watermark Column</label>
                        <input asp-for="WatermarkColumn" class="form-control" />
                    </div>
                </div>
                <div class="form-group" style="display:flex;align-items:center;gap:10px;">
                    <input asp-for="IsActive" type="checkbox" style="width:15px;height:15px;accent-color:var(--accent);cursor:pointer;" />
                    <label style="font-size:13px;color:var(--text-secondary);">Job is active</label>
                </div>
                <div class="section-divider"></div>
                <div style="display:flex;gap:8px;">
                    <button type="submit" class="btn btn-primary"><svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /></svg>Save Changes</button>
                    <a href="/MirrorJobs" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
@section Scripts {
    <script>
        function toggleWatermark() {
            const v = document.getElementById('syncMode').value;
            document.getElementById('watermarkGroup').style.display = v === '1' ? 'block' : 'none';
        }
        toggleWatermark();

        // ── Test Query ─────────────────────────────────────────────────────────
        async function testQuery() {
            const sourceId = parseInt(document.getElementById('sourceId').value);
            const query = document.getElementById('sourceQuery').value.trim();
            const resultBox = document.getElementById('queryTestResult');
            const btn = document.getElementById('btnTestQuery');

            if (!sourceId) { showQueryResult(false, 'Please select a Source first.'); return; }
            if (!query)    { showQueryResult(false, 'Query is empty.'); return; }

            btn.disabled = true;
            btn.textContent = 'Testing…';
            resultBox.style.display = 'none';

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            try {
                const res = await fetch('/MirrorJobs/TestQuery', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ sourceId, query })
                });
                const d = await res.json();
                if (d.success) {
                    showQueryResult(true, `✓ Query is valid. Result set has ${d.columnCount} column(s).`);
                } else {
                    showQueryResult(false, `✗ ${d.error}`);
                }
            } catch(e) {
                showQueryResult(false, '✗ Request failed. Check console.');
            }

            btn.disabled = false;
            btn.innerHTML = '<svg viewBox="0 0 24 24" style="width:13px;height:13px;"><polyline points="22 11.08 22 12 12 22 2 12 2 2 12 2 2 12 12 22 2"/></svg> Test Query';
        }

        function showQueryResult(success, msg) {
            const box = document.getElementById('queryTestResult');
            box.textContent = msg;
            box.style.display = 'block';
            box.style.background = success ? 'rgba(22,163,74,.12)' : 'rgba(220,38,38,.12)';
            box.style.color = success ? 'var(--success, #16a34a)' : 'var(--danger, #dc2626)';
            box.style.border = `1px solid ${success ? 'rgba(22,163,74,.3)' : 'rgba(220,38,38,.3)'}`;
        }
    </script>
}
