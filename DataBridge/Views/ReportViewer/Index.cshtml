@model List<DataBridge.Models.ViewModels.ReportBuilder.ReportListItemViewModel>
@{
    ViewData["Title"] = "Reports";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Reports</h1>
        <p class="page-subtitle">Available reports</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted p-5">No reports available.</div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var r in Model)
        {
            <div class="col-md-4">
                <a href="/ReportViewer/Run/@r.Id" class="text-decoration-none">
                    <div class="card h-100" style="transition:var(--transition);cursor:pointer" onmouseover="this.style.boxShadow='var(--shadow-md)'" onmouseout="this.style.boxShadow=''">
                        <div class="card-body">
                            <div class="d-flex align-items-start gap-3">
                                <div style="width:40px;height:40px;background:var(--accent-dim);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><polyline points="10 9 9 9 8 9" /></svg>
                                </div>
                                <div>
                                    <div class="fw-semibold">@r.Name</div>
                                    <div class="text-muted text-sm mt-1">@(r.Description ?? "No description")</div>
                                    @if (r.ParamCount > 0)
                                    {
                                        <span class="badge badge-secondary mt-2">@r.ParamCount param(s)</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}