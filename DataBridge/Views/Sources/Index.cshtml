@* ============================================================
   FILE: Views/Sources/Index.cshtml
   ============================================================ *@
@model DataBridge.Models.ViewModels.Sources.SourceListViewModel
@{
    ViewData["Title"] = "Sources";
}

<div class="page-header">
    <div>
        <div class="page-title">Sources</div>
        <div class="page-subtitle">Manage WMS regional database connections</div>
    </div>
    <div class="page-actions">
        <a href="/Sources/Create" class="btn btn-primary">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Add Source
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>@TempData["Error"]</div>
}

<div class="card" style="margin-bottom:16px;">
    <div class="card-body" style="padding:12px 16px;">
        <form method="get" style="display:flex;gap:10px;align-items:flex-end;">
            <div style="flex:1;">
                <label class="form-label">Search</label>
                <input name="search" class="form-control" placeholder="Name or description…" value="@Model.Search" />
            </div>
            <button type="submit" class="btn btn-primary">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                Search
            </button>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a href="/Sources" class="btn btn-secondary">Clear</a>
            }
        </form>
    </div>
</div>

<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Jobs</th>
                <th>Status</th>
                <th>Created</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Sources.Any())
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" /><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" /></svg>
                            <p>No sources found. Add your first WMS connection.</p>
                        </div>
                    </td>
                </tr>
            }
            @foreach (var s in Model.Sources)
            {
                <tr>
                    <td style="font-weight:500;color:var(--text-primary);">@s.Name</td>
                    <td style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(s.Description ?? "—")</td>
                    <td style="font-family:var(--mono);font-size:12px;">@s.JobCount job(s)</td>
                    <td>
                        <button class="badge @(s.IsActive ? "badge-success" : "badge-danger")"
                                style="border:none;cursor:pointer;"
                                onclick="toggleSource(@s.Id, this)">
                            @(s.IsActive ? "Active" : "Inactive")
                        </button>
                    </td>
                    <td style="font-family:var(--mono);font-size:11.5px;color:var(--text-muted);">@s.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td style="text-align:right;">
                        <div style="display:flex;gap:6px;justify-content:flex-end;">
                            <a href="/Sources/Edit/@s.Id" class="btn btn-secondary btn-sm">Edit</a>
                            <form method="post" action="/Sources/Delete/@s.Id" style="display:inline"
                                  onsubmit="return confirm('Delete source \'@s.Name\'? This cannot be undone.')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div style="margin-top:10px;font-size:12px;color:var(--text-muted);font-family:var(--mono);">@Model.Sources.Count source(s)</div>

@Html.AntiForgeryToken()
@section Scripts {
    <script>
        async function toggleSource(id, btn) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            btn.disabled = true;
            const res = await fetch('/Sources/ToggleActive', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
            });
            const data = await res.json();
            if (data.success) {
                const isNowActive = btn.classList.contains('badge-danger');
                btn.classList.toggle('badge-success', isNowActive);
                btn.classList.toggle('badge-danger', !isNowActive);
                btn.textContent = isNowActive ? 'Active' : 'Inactive';
            } else { alert(data.error ?? 'Failed'); }
            btn.disabled = false;
        }
    </script>
}


