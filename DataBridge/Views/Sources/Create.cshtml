@model DataBridge.Models.ViewModels.Sources.SourceFormViewModel
@{
    ViewData["Title"] = "Add Source";
}

<div class="page-header">
    <div>
        <div class="page-title">Add Source</div>
        <div class="page-subtitle">Configure a new WMS regional database connection</div>
    </div>
    <div class="page-actions">
        <a href="/Sources" class="btn btn-secondary">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
            Back
        </a>
    </div>
</div>

<div style="max-width:600px;">
    <div class="card">
        <div class="card-header"><span class="card-title">Connection Details</span></div>
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <div class="alert alert-danger">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                    <div>@foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) {
                    <div>@e.ErrorMessage</div>
                }
</div>
            </div>
                        }

            <form method="post" action="/Sources/Create">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">Source Name <span style="color:var(--danger)">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. WMS Jakarta" />
                    <div class="form-hint">Friendly name to identify this WMS regional database</div>
                </div>

                <div class="form-group">
                    <label class="form-label">Connection String <span style="color:var(--danger)">*</span></label>
                    <textarea asp-for="ConnectionString" class="form-control" rows="3"
                              placeholder="Server=REMOTE_SERVER;Database=WMS_DB;User Id=reader;Password=xxx;TrustServerCertificate=True;"></textarea>
                    <div class="form-hint">SQL Server connection string. Use a read-only account.</div>
                </div>

                <div class="form-group">
                    <label class="form-label">Description</label>
                    <input asp-for="Description" class="form-control" placeholder="Optional notes about this source" />
                </div>

                <div class="section-divider"></div>

                <div id="testResult" style="display:none;margin-bottom:14px;"></div>

                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                    <button type="submit" class="btn btn-primary">
                        <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /></svg>
                        Save Source
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="testConn()" id="testBtn">
                        <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
                        Test Connection
                    </button>
                    <a href="/Sources" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function testConn() {
            const cs   = document.getElementById('ConnectionString').value;
            const btn  = document.getElementById('testBtn');
            const res  = document.getElementById('testResult');
            if (!cs.trim()) { alert('Please enter a connection string first.'); return; }
            btn.disabled = true;
            btn.textContent = 'Testing…';
            res.style.display = 'none';
            try {
                const r = await fetch('/Sources/TestConnection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ connectionString: cs })
                });
                const d = await r.json();
                res.style.display = 'flex';
                res.className = 'alert ' + (d.success ? 'alert-success' : 'alert-danger');
                res.innerHTML = (d.success
                    ? '<svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>'
                    : '<svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>')
                    + '<span>' + d.message + '</span>';
            } catch { res.style.display = 'flex'; res.className = 'alert alert-danger'; res.innerHTML = '<span>Request failed</span>'; }
            btn.disabled = false;
            btn.innerHTML = '<svg viewBox="0 0 24 24" style="width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg> Test Connection';
        }
    </script>
}