@* FILE: Views/Dashboard/Index.cshtml *@
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <div class="page-title">Dashboard</div>
        <div class="page-subtitle">Overview of all mirroring activity</div>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary">
            <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            Refresh
        </button>
    </div>
</div>

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card accent-blue">
        <div class="stat-label">Total Jobs</div>
        <div class="stat-value">0</div>
        <div class="stat-footer">No jobs configured yet</div>
    </div>
    <div class="stat-card accent-green">
        <div class="stat-label">Successful Runs</div>
        <div class="stat-value">0</div>
        <div class="stat-footer">Last 7 days</div>
    </div>
    <div class="stat-card accent-amber">
        <div class="stat-label">Active Schedules</div>
        <div class="stat-value">0</div>
        <div class="stat-footer">Running jobs</div>
    </div>
    <div class="stat-card accent-red">
        <div class="stat-label">Failed Runs</div>
        <div class="stat-value">0</div>
        <div class="stat-footer">Last 7 days</div>
    </div>
</div>

<!-- Recent Activity -->
<div class="card">
    <div class="card-header">
        <span class="card-title">Recent Job History</span>
        <a href="/JobHistory" class="btn btn-secondary btn-sm">View All</a>
    </div>
    <div class="empty-state">
        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <p>No job history yet. Configure a mirror job to get started.</p>
    </div>
</div>
