@model DataBridge.Models.ViewModels.Schedules.ScheduleListViewModel
@{
    ViewData["Title"] = "Schedules";
}

<div class="page-header">
    <div><div class="page-title">Schedules</div><div class="page-subtitle">Manage automated sync schedules</div></div>
    <div class="page-actions">
        <a href="/MirrorJobs" class="btn btn-secondary">
            <svg viewBox="0 0 24 24"><polyline points="16 3 21 3 21 8" /><line x1="4" y1="20" x2="21" y2="3" /><polyline points="21 16 21 21 16 21" /></svg>
            Go to Jobs
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>@TempData["Error"]</div>
}

<div class="alert alert-info" style="margin-bottom:16px;">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
    <span>To add a schedule to a job, go to <a href="/MirrorJobs" style="color:var(--accent);text-decoration:underline;">Mirror Jobs</a> and click the clock icon on any job.</span>
</div>

<div class="table-wrap">
    <table class="data-table">
        <thead><tr><th>Job Name</th><th>Source</th><th>Cron Expression</th><th>Last Run</th><th>Next Run</th><th>Status</th><th style="text-align:right;">Actions</th></tr></thead>
        <tbody>
            @if (!Model.Schedules.Any())
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                            <p>No schedules configured. Add a schedule from the Mirror Jobs page.</p>
                        </div>
                    </td>
                </tr>
            }
            @foreach (var s in Model.Schedules)
            {
                <tr>
                    <td style="font-weight:500;color:var(--text-primary);">@s.JobName</td>
                    <td>@s.SourceName</td>
                    <td style="font-family:var(--mono);font-size:12px;">@s.CronExpression</td>
                    <td style="font-family:var(--mono);font-size:11.5px;color:var(--text-muted);">
                        @(s.LastRunAt.HasValue? s.LastRunAt.Value.ToString("dd MMM HH:mm") : "—")
                    </td>
                    <td style="font-family:var(--mono);font-size:11.5px;color:var(--text-muted);">
                        @(s.NextRunAt.HasValue? s.NextRunAt.Value.ToString("dd MMM HH:mm") : "—")
                    </td>
                    <td>
                        <button class="badge @(s.IsEnabled ? "badge-success" : "badge-muted")"
                                style="border:none;cursor:pointer;" onclick="toggleSched(@s.Id, this)">
                            @(s.IsEnabled ? "Enabled" : "Disabled")
                        </button>
                    </td>
                    <td style="text-align:right;">
                        <div style="display:flex;gap:5px;justify-content:flex-end;">
                            <a href="/Schedules/Configure?jobId=@s.MirrorJobId" class="btn btn-secondary btn-sm">Edit</a>
                            <form method="post" action="/Schedules/Delete/@s.Id" style="display:inline"
                                  onsubmit="return confirm('Remove schedule for \'@s.JobName\'?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@Html.AntiForgeryToken()
@section Scripts {
    <script>
        async function toggleSched(id, btn) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            btn.disabled = true;
            const res = await fetch('/Schedules/Toggle', {
                method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'},
                body: `id=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
            });
            const d = await res.json();
            if (d.success) {
                const on = btn.classList.contains('badge-muted');
                btn.classList.toggle('badge-success', on); btn.classList.toggle('badge-muted', !on);
                btn.textContent = on ? 'Enabled' : 'Disabled';
            } else alert(d.error ?? 'Failed');
            btn.disabled = false;
        }
    </script>
}