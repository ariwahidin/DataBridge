@model DataBridge.Models.ViewModels.Schedules.ScheduleFormViewModel
@{
    ViewData["Title"] = "Configure Schedule";
}

<div class="page-header">
    <div><div class="page-title">Configure Schedule</div><div class="page-subtitle">@Model.JobName</div></div>
    <div class="page-actions"><a href="/Schedules" class="btn btn-secondary"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>Back</a></div>
</div>

<div style="max-width:560px;">
    <div class="card">
        <div class="card-header"><span class="card-title">Schedule Settings</span></div>
        <div class="card-body">
            <form method="post" action="/Schedules/Configure">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="MirrorJobId" type="hidden" />
                <input asp-for="JobName" type="hidden" />

                <div class="form-group">
                    <label class="form-label">Cron Expression <span style="color:var(--danger)">*</span></label>
                    <input asp-for="CronExpression" class="form-control" placeholder="0 0 * * *" />
                    <div class="form-hint">Standard 5-field cron. Examples: <code style="font-family:var(--mono);font-size:11.5px;">0 2 * * *</code> = daily 2AM, <code style="font-family:var(--mono);font-size:11.5px;">0 */6 * * *</code> = every 6h, <code style="font-family:var(--mono);font-size:11.5px;">0 8 * * 1</code> = Monday 8AM</div>
                </div>

                <!-- Quick presets -->
                <div style="margin-bottom:16px;">
                    <div class="form-label" style="margin-bottom:8px;">Quick Presets</div>
                    <div style="display:flex;gap:6px;flex-wrap:wrap;">
                        @foreach (var p in new[] {
                                                ("Every hour", "0 * * * *"),
                                                ("Every 6h", "0 */6 * * *"),
                                                ("Daily 1AM", "0 1 * * *"),
                                                ("Daily midnight", "0 0 * * *"),
                                                ("Mon–Fri 7AM", "0 7 * * 1-5"),
                                                ("Weekly Sunday", "0 0 * * 0"),
                                                })
                        {
                            <button type="button" class="btn btn-secondary btn-sm"
                                    onclick="document.getElementById('CronExpression').value='@p.Item2'">
                                @p.Item1
                            </button>
                        }
                    </div>
                </div>

                <div class="form-group" style="display:flex;align-items:center;gap:10px;">
                    <input asp-for="IsEnabled" type="checkbox" style="width:15px;height:15px;accent-color:var(--accent);cursor:pointer;" />
                    <label style="font-size:13px;color:var(--text-secondary);">Schedule is enabled</label>
                </div>

                <div class="section-divider"></div>
                <div style="display:flex;gap:8px;">
                    <button type="submit" class="btn btn-primary">
                        <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /></svg>
                        Save Schedule
                    </button>
                    <a href="/Schedules" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>