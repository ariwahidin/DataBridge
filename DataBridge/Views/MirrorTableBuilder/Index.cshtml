@model List<DataBridge.Models.ViewModels.MirrorTableBuilder.TableInfoViewModel>
@{
    ViewData["Title"] = "Table Builder";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Table Builder</h1>
        <p class="page-subtitle">Manage tables in the Mirror database</p>
    </div>
    <a href="/MirrorTableBuilder/Create" class="btn btn-primary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
        New Table
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state p-5 text-center">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" class="mb-3"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>
                <p class="text-muted">No tables found in the Mirror database.</p>
                <a href="/MirrorTableBuilder/Create" class="btn btn-primary mt-2">Create your first table</a>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Table Name</th>
                        <th class="text-center">Columns</th>
                        <th class="text-center">Rows</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>
                                    <code class="text-sm">@t.TableName</code>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge badge-secondary">@t.ColumnCount</span>
                            </td>
                            <td class="text-center">
                                <span class="text-muted text-sm">@(t.RowCount >= 0 ? t.RowCount.ToString("N0") : "—")</span>
                            </td>
                            <td>
                                <span class="text-muted text-sm">@(t.CreatedDate?.ToString("dd MMM yyyy") ?? "—")</span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a href="/MirrorDataExplorer/Browse?tableName=@Uri.EscapeDataString(t.TableName)"
                                       class="btn btn-sm btn-ghost" title="Browse data">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                        Browse
                                    </a>
                                    <a href="/MirrorTableBuilder/Edit?tableName=@Uri.EscapeDataString(t.TableName)"
                                       class="btn btn-sm btn-ghost" title="Edit schema">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                        </svg>
                                        Edit
                                    </a>
                                    <button class="btn btn-sm btn-ghost"
                                            onclick="confirmRename('@t.TableName')" title="Rename table">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />
                                        </svg>
                                        Rename
                                    </button>
                                    <button class="btn btn-sm btn-ghost text-danger"
                                            onclick="confirmDrop('@t.TableName')" title="Drop table">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6M14 11v6" /><path d="M9 6V4h6v2" /></svg>
                                        Drop
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Rename Modal -->
<div class="modal fade" id="renameModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rename Table</h5>
            </div>
            <div class="modal-body">
                <p class="text-muted text-sm mb-2">Renaming: <strong id="renameOldName"></strong></p>
                <label class="form-label">New Name</label>
                <input type="text" id="renameNewName" class="form-control form-control-sm" placeholder="NewTableName" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                <form id="renameForm" method="post" action="/MirrorTableBuilder/Rename">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tableName" id="renameTableInput" />
                    <input type="hidden" name="newName" id="renameNewInput" />
                    <button type="button" class="btn btn-primary" onclick="submitRename()">Rename</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Drop Confirmation Modal -->
<div class="modal fade" id="dropModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Drop Table</h5>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to drop <strong id="dropTableName"></strong>?</p>
                <p class="text-danger text-sm">This action cannot be undone. All data will be lost.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                <form id="dropForm" method="post" action="/MirrorTableBuilder/Drop">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tableName" id="dropTableInput" />
                    <button type="submit" class="btn btn-danger">Drop Table</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDrop(tableName) {
            document.getElementById('dropTableName').textContent = tableName;
            document.getElementById('dropTableInput').value = tableName;
            const modal = new bootstrap.Modal(document.getElementById('dropModal'));
            modal.show();
        }

        function confirmRename(tableName) {
            document.getElementById('renameOldName').textContent  = tableName;
            document.getElementById('renameTableInput').value     = tableName;
            document.getElementById('renameNewName').value        = '';
            const modal = new bootstrap.Modal(document.getElementById('renameModal'));
            modal.show();
        }

        function submitRename() {
            const newName = document.getElementById('renameNewName').value.trim();
            if (!newName) { alert('New name cannot be empty.'); return; }
            document.getElementById('renameNewInput').value = newName;
            document.getElementById('renameForm').submit();
        }
    </script>
}
