@model DataBridge.Models.ViewModels.JobHistory.JobHistoryListViewModel
@{
    ViewData["Title"] = "Job History";
}

<div class="page-header">
    <div><div class="page-title">Job History</div><div class="page-subtitle">Execution log for all mirror jobs</div></div>
    <div class="page-actions">
        <a href="/JobHistory/Export?jobId=@Model.FilterJobId&status=@Model.FilterStatus" class="btn btn-secondary">
            <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
            Export Excel
        </a>
    </div>
</div>

<div class="card" style="margin-bottom:16px;">
    <div class="card-body" style="padding:12px 16px;">
        <form method="get" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
            <div style="min-width:160px;">
                <label class="form-label">Status</label>
                <select name="status" class="form-control">
                    <option value="">All Status</option>
                    <option value="Success" selected="@(Model.FilterStatus == "Success" ? "selected" : null)">Success</option>
                    <option value="Failed" selected="@(Model.FilterStatus == "Failed" ? "selected" : null)">Failed</option>
                    <option value="Running" selected="@(Model.FilterStatus == "Running" ? "selected" : null)">Running</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>Filter</button>
            @if (!string.IsNullOrEmpty(Model.FilterStatus))
            {
                <a href="/JobHistory" class="btn btn-secondary">Clear</a>
            }
        </form>
    </div>
</div>

<div class="table-wrap">
    <table class="data-table">
        <thead><tr><th>Job Name</th><th>Started</th><th>Finished</th><th>Duration</th><th>Rows</th><th>Triggered By</th><th>Status</th><th>Error</th></tr></thead>
        <tbody>
            @if (!Model.Histories.Any())
            {
                <tr>
                    <td colspan="8">
                        <div class="empty-state">
                            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                            <p>No history found.</p>
                        </div>
                    </td>
                </tr>
            }
            @foreach (var h in Model.Histories)
            {
                <tr>
                    <td style="font-weight:500;color:var(--text-primary);">@h.JobName</td>
                    <td style="font-family:var(--mono);font-size:11.5px;">@h.StartedAt.ToString("dd MMM HH:mm:ss")</td>
                    <td style="font-family:var(--mono);font-size:11.5px;color:var(--text-muted);">
                        @(h.FinishedAt.HasValue? h.FinishedAt.Value.ToString("HH:mm:ss") : "—")
                    </td>
                    <td style="font-family:var(--mono);font-size:11.5px;">
                        @(h.DurationSeconds.HasValue ? $"{h.DurationSeconds.Value:F1}s" : "—")
                    </td>
                    <td style="font-family:var(--mono);font-size:11.5px;">@(h.RowsAffected?.ToString("N0") ?? "—")</td>
                    <td style="font-size:12px;">@h.TriggeredBy</td>
                    <td>
                        @if (h.Status == DataBridge.Models.Enums.JobStatus.Success)
                        {
                            <span class="badge badge-success">Success</span>
                        }
                        else if (h.Status == DataBridge.Models.Enums.JobStatus.Failed)
                        {

                            <span class="badge badge-danger">Failed</span>
                        }
                        else
                        {

                            <span class="badge badge-warning">Running</span>
                        }
                    </td>
                    <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11.5px;color:var(--danger);"
                        title="@h.ErrorMessage">
                        @(h.ErrorMessage ?? "")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div style="margin-top:10px;font-size:12px;color:var(--text-muted);font-family:var(--mono);">@Model.TotalCount record(s)</div>
